# Django Backend Configuration
DJANGO_BASE_URL=http://localhost:8000

# JWT Configuration
JWT_AUDIENCE=cccrm-api
JWT_ISSUER=cccrm-backend
JWT_PUBLIC_KEY=
# Optional: JWT_PUBLIC_KEY can be left empty to use JWKS endpoint

# OAuth2 Metadata URLs (optional)
AUTHORIZATION_SERVER_URL=
RESOURCE_METADATA_URL=
METADATA_JSON_RESPONSE=

# JWKS Cache Settings (optional)
JWKS_CACHE_TTL=3600

# Optional: Tavily API Key for tools
TAVILY_API_KEY=

# Server Configuration
PORT=10000